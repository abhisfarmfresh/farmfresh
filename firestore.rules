// Firestore Security Rules for Abhis Farm Fresh
// Deploy via Firebase Console → Firestore Database → Rules tab

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Products — public read and admin write for real-time daily price updates
    match /products/{productId} {
      allow read, write: if true;
    }

    // Orders — customer creation, admin verification and updates
    match /orders/{orderId} {
      allow read, create, update: if true;
      allow delete: if false;  // Orders should never be deleted
    }

    // Customers — customer registry and order history
    match /customers/{customerId} {
      allow read, write: if true;
    }
  }
}
