// Firestore Security Rules for Abhis Farm Fresh
// Deploy via Firebase Console → Firestore Database → Rules tab

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if the caller is an authenticated administrator
    function isAdmin() {
      return request.auth != null;
    }

    // Products — public read for customer storefront, admin-only write
    match /products/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders — public creation with strict schema validation, admin-only read, update & delete
    match /orders/{id} {
      allow create: if request.resource.data.keys().hasAll(['customerName', 'phone', 'items', 'subtotal', 'grandTotal', 'status'])
                    && request.resource.data.status == 'pending'
                    && request.resource.data.customerName is string && request.resource.data.customerName.size() >= 2
                    && request.resource.data.phone is string && request.resource.data.phone.size() >= 8
                    && request.resource.data.items is list && request.resource.data.items.size() > 0
                    && request.resource.data.grandTotal is number && request.resource.data.grandTotal >= 0;
      allow read, update, delete: if isAdmin();
    }

    // Customers — public creation/merge on order checkout, admin-only read and management
    match /customers/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Customer Inquiries & Leads — public submission with validation, admin-only read/write
    match /inquiries/{id} {
      allow create: if request.resource.data.keys().hasAll(['name', 'phone', 'message'])
                    && request.resource.data.name is string && request.resource.data.name.size() >= 2
                    && request.resource.data.phone is string && request.resource.data.phone.size() >= 8
                    && request.resource.data.message is string && request.resource.data.message.size() >= 3;
      allow read, update, delete: if isAdmin();
    }

    // Store Settings & Promo Banners — public read, admin-only write
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Product Categories — public read, admin-only write
    match /categories/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}

